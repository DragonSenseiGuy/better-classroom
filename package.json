{
	"name": "classroom",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"bench": "bun bench/search.bench.ts",
		"start": "bun build/index.js",
		"seed": "bun scripts/seed.ts"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.0",
		"@sveltejs/adapter-node": "^6.0.0-next.10",
		"@sveltejs/kit": "^3.0.0-next.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.2",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^26.5.0",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/valley-sans": "^5.3.1",
		"@leeoniya/ufuzzy": "^1.0.19",
		"@lucide/svelte": "^1.46.0",
		"@tanstack/db": "^0.8.7",
		"@tanstack/svelte-db": "^0.3.7",
		"@tanstack/svelte-hotkeys": "^0.10.0",
		"@tanstack/svelte-table": "^9.2.4",
		"canvas-confetti": "^1.9.4",
		"virtua": "^0.51.2"
	}
