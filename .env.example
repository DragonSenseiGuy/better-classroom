# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app, e.g. http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173

# Optional: lets people sign in with a Google account instead of email + password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared auth database; per-user Classroom caches live in users/ beside it
DATABASE_PATH=data/classroom.sqlite

# Minutes between background syncs (1 or more)
SYNC_INTERVAL_MINUTES=5

# How many courses one sync fetches at a time
SYNC_CONCURRENCY=2

# How often a sync refetches everything instead of only recent changes
FULL_SYNC_HOURS=6

# Account id that `bun run seed` fills with fixture data (defaults to the first account)
SEED_USER=

# Key the local mock Classroom server accepts (`bun run mock`)
APPS_SCRIPT_KEY=mock
